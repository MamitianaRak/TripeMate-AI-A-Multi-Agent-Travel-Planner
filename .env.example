# Copy to .env and fill in your keys. Never commit .env.

# --- Required ---------------------------------------------------------------
GROQ_API_KEY=
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=
DATABASE_URL=postgresql://tripmate:tripmate@localhost:5432/tripmate

# --- Optional ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON log lines (recommended in production)
LOG_JSON=false

GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MCP_TIMEOUT_SECONDS=60
# gpt-oss is a reasoning model: "low" leaves more output tokens for the answer.
# Leave empty if you switch to a non-reasoning model.
LLM_REASONING_EFFORT=low
# Times the LLM continues an answer cut by the output limit
LLM_MAX_CONTINUATIONS=2
# Target prompt size; larger sections are condensed by the LLM, never truncated
PROMPT_BUDGET_TOKENS=4000

# "require" for hosted databases (Render), "disable" for a local Postgres without SSL
DATABASE_SSLMODE=disable
DATABASE_POOL_SIZE=5

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Requests per window and per client IP on /api/travel*  (0 disables the limit)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Set to true only behind a trusted proxy (Render, nginx) to read X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tripmate-ai
